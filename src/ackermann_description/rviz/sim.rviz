Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /planned_path
        Durability Policy: Transient Local
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Real path (ground truth)
      Enabled: true
      Topic:
        Value: /executed_path
      Color: 255; 85; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 1
      Shape:
        Value: Arrow
    - Class: rviz_default_plugins/PointStamped
      Name: Look-ahead point
      Enabled: true
      Topic:
        Value: /tracking/lookahead
      Color: 255; 0; 255
      Radius: 0.06
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 90
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 800
