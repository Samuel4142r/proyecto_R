<?xml version="1.0"?>
<!--
  Robot Ackermann — modelo PROVISIONAL (cajas y cilindros).
  Parametros del Integrante B (tabla de parametros):
    L = 0.30 m, W = 0.22 m, r = 0.05 m, ancho rueda = 0.03 m,
    delta_max = 30 deg, chasis 0.40 x 0.20 x 0.05 m, m_chasis = 2.0 kg, m_rueda = 0.2 kg

  Convencion de marcos:
    base_link = punto medio del EJE TRASERO, a la altura de los ejes de rueda,
                X hacia adelante, Y a la izquierda, Z hacia arriba.
    (Es el punto de referencia del modelo bicicleta y de Pure Pursuit.)

  Nombres de links/joints acordados con B (NO cambiarlos al importar el CAD):
    links : base_link, front_left_steer, front_right_steer,
            front_left_wheel, front_right_wheel, rear_left_wheel, rear_right_wheel
    joints: front_left_steer_joint, front_right_steer_joint,
            front_left_wheel_joint, front_right_wheel_joint,
            rear_left_wheel_joint,  rear_right_wheel_joint

  Para usar los meshes STL de B:  xacro ... use_meshes:=true
  (los archivos deben llamarse meshes/<nombre_del_link>.stl, en metros).
-->
<robot name="ackermann_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_meshes" default="false"/>
  <xacro:property name="use_meshes" value="$(arg use_meshes)"/>

  <!-- ===================== Parametros (fuente unica) ===================== -->
  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="wheel_base"   value="0.30"/>   <!-- L -->
  <xacro:property name="track"        value="0.22"/>   <!-- W -->
  <xacro:property name="wheel_radius" value="0.05"/>   <!-- r -->
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="steer_max"    value="${30.0 * PI / 180.0}"/>
  <xacro:property name="chassis_x"    value="0.40"/>
  <xacro:property name="chassis_y"    value="0.20"/>
  <xacro:property name="chassis_z"    value="0.05"/>
  <xacro:property name="chassis_mass" value="2.0"/>
  <xacro:property name="wheel_mass"   value="0.2"/>
  <xacro:property name="steer_mass"   value="0.05"/>
  <!-- El chasis esta centrado entre los dos ejes -->
  <xacro:property name="chassis_offset_x" value="${wheel_base / 2.0}"/>
  <xacro:property name="chassis_offset_z" value="0.0"/>

  <!-- ===================== Materiales ===================== -->
  <material name="chassis_blue"><color rgba="0.10 0.35 0.75 1.0"/></material>
  <material name="tire_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="steer_grey"><color rgba="0.60 0.60 0.60 1.0"/></material>
  <material name="top_orange"><color rgba="0.95 0.55 0.10 1.0"/></material>

  <!-- ===================== Macros de inercia ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
             izz="${m * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <!-- Cilindro con eje a lo largo de Y del link (rueda) -->
  <xacro:macro name="wheel_inertia" params="m r h">
    <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
             iyy="${m * r * r / 2.0}" iyz="0"
             izz="${m * (3*r*r + h*h) / 12.0}"/>
  </xacro:macro>

  <!-- ===================== base_link (eje trasero) ===================== -->
  <link name="base_link"/>

  <!-- Chasis: link fijo a base_link (Gazebo lo fusiona; evita el aviso de KDL
       sobre inercia en el link raiz) -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_offset_x} 0 ${chassis_offset_z}" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <xacro:if value="${use_meshes}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://ackermann_description/meshes/base_link.stl"/></geometry>
      </xacro:if>
      <xacro:unless value="${use_meshes}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      </xacro:unless>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_x}" y="${chassis_y}" z="${chassis_z}"/>
    </inertial>
  </link>

  <!-- Soporte / carcasa superior (solo visual, masa incluida en el chasis) -->
  <joint name="top_cover_joint" type="fixed">
    <parent link="chassis"/>
    <child link="top_cover"/>
    <origin xyz="-0.02 0 ${chassis_z / 2.0 + 0.02}" rpy="0 0 0"/>
  </joint>
  <link name="top_cover">
    <visual>
      <geometry><box size="0.20 0.14 0.04"/></geometry>
      <material name="top_orange"/>
    </visual>
  </link>

  <!-- ===================== Ruedas traseras (traccion) ===================== -->
  <xacro:macro name="wheel" params="name parent x y">
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.001" friction="0.0"/>
    </joint>
    <link name="${name}">
      <visual>
        <xacro:if value="${use_meshes}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://ackermann_description/meshes/${name}.stl"/></geometry>
        </xacro:if>
        <xacro:unless value="${use_meshes}">
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </xacro:unless>
        <material name="tire_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1.0e6</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="rear_left_wheel"  parent="base_link" x="0.0" y="${ track / 2.0}"/>
  <xacro:wheel name="rear_right_wheel" parent="base_link" x="0.0" y="${-track / 2.0}"/>

  <!-- ===================== Direccion delantera ===================== -->
  <xacro:macro name="steer" params="side y">
    <joint name="front_${side}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_steer"/>
      <origin xyz="${wheel_base} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steer_max}" upper="${steer_max}" effort="10.0" velocity="5.0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <link name="front_${side}_steer">
      <visual>
        <xacro:if value="${use_meshes}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="package://ackermann_description/meshes/front_${side}_steer.stl"/></geometry>
        </xacro:if>
        <xacro:unless value="${use_meshes}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><cylinder radius="0.008" length="0.05"/></geometry>
        </xacro:unless>
        <material name="steer_grey"/>
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${steer_mass}"/>
        <inertia ixx="1.2e-5" ixy="0" ixz="0" iyy="1.2e-5" iyz="0" izz="2.0e-6"/>
      </inertial>
    </link>
    <xacro:wheel name="front_${side}_wheel" parent="front_${side}_steer" x="0.0" y="0.0"/>
  </xacro:macro>

  <xacro:steer side="left"  y="${ track / 2.0}"/>
  <xacro:steer side="right" y="${-track / 2.0}"/>

  <!-- ===================== Plugins de Gazebo Harmonic ===================== -->
  <xacro:include filename="$(find ackermann_description)/urdf/ackermann.gazebo.xacro"/>
  <xacro:ackermann_gazebo wheel_base="${wheel_base}" track="${track}"
                          wheel_radius="${wheel_radius}" steer_max="${steer_max}"/>

</robot>
